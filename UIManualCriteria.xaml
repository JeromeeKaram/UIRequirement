<Window x:Class="UIRequirement.Views.UIManualCriteria"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manual Criteria"
        Height="140"
        Width="740"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#D2FAFF">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Label -->
        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0"
                   FontFamily="Verdana"
                   FontSize="9"
                   FontWeight="Bold"
                   Foreground="#194682"
                   Text="Manual Criteria"/>

        <!-- ComboBox -->
        <ComboBox x:Name="cbMC"
                  Grid.Row="0"
                  Grid.Column="1"
                  Height="25"
                  Width="580"
                  HorizontalAlignment="Left"
                  Background="#D2FAFF"
                  FontFamily="Verdana"
                  FontSize="8"
                  IsEditable="False"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button x:Name="btnOK"
                    Width="90"
                    Height="32"
                    Margin="0,0,5,0"
                    Content="OK"
                    Click="btnOK_Click"
                    Background="#D2FAFF"
                    Foreground="#194682"
                    FontFamily="Verdana"
                    FontSize="10"
                    FontWeight="Bold"/>

            <Button x:Name="btnCancel"
                    Width="90"
                    Height="32"
                    Content="Cancel"
                    Click="btnCancel_Click"
                    Background="#D2FAFF"
                    Foreground="#194682"
                    FontFamily="Verdana"
                    FontSize="10"
                    FontWeight="Bold"/>

        </StackPanel>

    </Grid>
</Window>