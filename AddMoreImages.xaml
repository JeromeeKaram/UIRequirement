<Window x:Class="UIRequirement.AddMoreImages"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIRequirement"
        mc:Ignorable="d"
        Title="AddMoreImages" Height="450" Width="800">
    <Grid Margin="10">

        <GroupBox Margin="0,0,0,50">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="170"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="180"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Select Image -->
                <TextBlock Grid.Row="0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="Select Image:" />

                <ComboBox x:Name="cbAddMoreImages"
                          Grid.Row="0"
                          Grid.Column="0"
                          Margin="100,0,0,0"
                          Width="186"
                          Height="25"
                          Background="#D2FAFF"
                          SelectionChanged="cbAddMoreImages_SelectionChanged" />

                <!-- Preview Image -->
                <Border Grid.Row="2"
                        Grid.Column="0"
                        Width="280"
                        Height="176"
                        Background="Silver"
                        BorderBrush="Gray"
                        BorderThickness="1">

                    <Image x:Name="pictureBox1"
                           Stretch="Uniform"/>
                </Border>

                <!-- Image Name -->
                <StackPanel Grid.Row="2"
                            Grid.Column="1"
                            Margin="10,10,10,0">

                    <TextBlock Text="Image Name"
                               FontSize="14"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="tbImageName"
                             Width="140"/>

                    <Button x:Name="btnAdd"
                            Content="Add Image"
                            Width="120"
                            Height="30"
                            Margin="0,20,0,0"
                            Click="btnAdd_Click"/>

                    <Button x:Name="btnClear"
                            Content="Clear Images"
                            Width="120"
                            Height="30"
                            Margin="0,10,0,0"
                            Click="btnClear_Click"/>
                </StackPanel>

                <!-- Images Added -->
                <ListBox x:Name="lbImagesAdded"
                         Grid.RowSpan="3"
                         Grid.Column="2"
                         Width="160"
                         Height="225"/>
            </Grid>
        </GroupBox>

        <!-- Bottom Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom">

            <Button x:Name="btnOK"
                    Content="OK"
                    Width="100"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="btnOK_Click"/>

            <Button x:Name="btnCancel"
                    Content="Cancel"
                    Width="100"
                    Height="30"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
