<Window x:Class="UIRequirement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UIRequirement"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="CTR Form Automation Tool V3.1"
        WindowState="Maximized" Background="#E3F2FD">

    <Window.Resources>

        <Style x:Key="BlueRaisedButton"
               TargetType="Button"
               BasedOn="{StaticResource MaterialDesignRaisedButton}">
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

    </Window.Resources>

    <Grid Margin="5">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header Card -->
            <RowDefinition Height="Auto"/>
            <!-- Menu Card -->
            <RowDefinition Height="*"/>
            <!-- Main Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <materialDesign:Card Grid.Row="0"
                     Margin="0,0,0,8"
                     Padding="0">

            <Grid Height="45">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <!-- Menu Area -->
                    <ColumnDefinition Width="*"/>
                    <!-- Header Area -->
                </Grid.ColumnDefinitions>

                <!-- Menu Section -->
                <Border Grid.Column="0"
                Background="LightBlue">

                    <Menu Background="Transparent"
                  BorderThickness="0"
                  Foreground="White"
                  VerticalAlignment="Center">

                        <MenuItem Header="_File" Foreground="Black">
                            <MenuItem Header="_Open"/>
                            <Separator/>
                            <MenuItem Header="_Exit"
                              Click="MenuExit_Click"/>
                        </MenuItem>

                        <MenuItem Header="_Help" Foreground="Black">
                            <MenuItem Header="_About"
                              Click="MenuAbout_Click"/>
                        </MenuItem>

                    </Menu>

                </Border>

                <!-- Header Section -->
                <Border Grid.Column="1"
        Background="LightBlue">

                    <Grid Margin="10,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <!-- Title -->
                            <ColumnDefinition Width="Auto"/>
                            <!-- IHI -->
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <TextBlock Grid.Column="0"
                   Text="CTR Form Automation Tool V3.1"
                   Foreground="Black"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

                        <!-- IHI -->
                        <TextBlock Grid.Column="1"
                   Text="IHI"
                   Margin="15,0,0,0"
                   Foreground="Black"
                   FontSize="20"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

                    </Grid>

                </Border>

            </Grid>

        </materialDesign:Card>

        <!-- Main Content -->

            <StackPanel Grid.Row="2">

                <!-- Finding Ticket -->
                <materialDesign:Card Margin="0 0 0 12"
                                     Padding="5"
                                     BorderThickness="1">

                    <StackPanel>

                        <TextBlock Text="Finding Ticket Information"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#1565C0"/>

                        <Grid Margin="0 16 0 0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center">
    <Run Text="Finding Ticket No"/>
    <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBox Grid.Column="1"
                                     Margin="8 0"/>

                            <Button Grid.Column="2"
                                    Command="{Binding LoadCommand}"
        Style="{StaticResource MaterialDesignOutlinedButton}"
        Padding="10,5">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpen"
                                 Width="16"
                                 Height="16"
                                 Margin="0,0,5,0"/>
                                    <TextBlock Text="Load"
                   VerticalAlignment="Center"/>
                                </StackPanel>

                            </Button>

                        <TextBlock Grid.Column="3"
           Margin="20 0 0 0"
           VerticalAlignment="Center">
    <Run Text="ESN"/>
    <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBox Grid.Column="4"/>

                        <TextBlock Grid.Column="5"
           Margin="20 0 0 0"
           VerticalAlignment="Center">
    <Run Text="TSN"/>
    <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBox Grid.Column="6"/>

                        <TextBlock Grid.Column="7"
           Margin="20 0 0 0"
           VerticalAlignment="Center">
    <Run Text="CSN"/>
    <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                        </TextBlock>

                        <TextBox Grid.Column="8"/>

                        </Grid>
                        <Border BorderThickness="1" BorderBrush="LightBlue"
CornerRadius="4"
Padding="8" Margin="0,5,0,0">
                        <TextBox
                            materialDesign:HintAssist.Hint="Enter Finding Ticket Details ..."
                            Margin="0 16 0 0"
                            Height="50"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto"/>
                            </Border>
                    </StackPanel>

                </materialDesign:Card>

                <!-- Damage Information -->
                <materialDesign:Card Padding="5"
                                     BorderThickness="1">

                    <StackPanel>
                        

                        <TextBlock Text="Enter Damage Information"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Foreground="#1565C0"/>

                        <Border BorderThickness="1" BorderBrush="LightBlue" CornerRadius="4"
Padding="8"  Margin="0,5,0,0">
                            <TextBox
                            materialDesign:HintAssist.Hint="Enter damage description..."
                            Margin="0 16 0 0"
                            Height="50"
                            AcceptsReturn="True"/>
                        </Border>

                        <Grid Margin="0,20,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                        <ComboBox Grid.Row="0"
          Grid.Column="0">

                            <materialDesign:HintAssist.Hint>
                                <TextBlock>
            <Run Text="Part Repair"/>
            <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                                </TextBlock>
                            </materialDesign:HintAssist.Hint>

                        </ComboBox>

                        <ComboBox Grid.Row="0"
          Grid.Column="2">

                            <materialDesign:HintAssist.Hint>
                                <TextBlock>
            <Run Text="Location"/>
            <Run Text="*" Foreground="Red" FontWeight="Bold"/>
                                </TextBlock>
                            </materialDesign:HintAssist.Hint>

                        </ComboBox>

                        <ComboBox Grid.Row="0"
              Grid.Column="4"
              materialDesign:HintAssist.Hint="Non-conformance Type" />

                            <!-- Row 2 -->
                            <Grid Grid.Row="1"
      Grid.Column="0"
      Margin="0,12,0,0">

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

    <ComboBox Grid.Column="0"
              Margin="0,0,5,0"
              materialDesign:HintAssist.Hint="Overview Image"/>

    <Button Grid.Column="1"
            Click="OverviewInfo_Click"
            Background="Transparent"
            BorderThickness="0"
            Padding="0">

        <materialDesign:PackIcon Kind="InformationOutline"
                                 Width="18"
                                 Height="18"
                                 Foreground="DodgerBlue"/>
    </Button>

</Grid>

                            <Grid Grid.Row="1"
      Grid.Column="2"
      Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
              Margin="0,0,5,0"
              materialDesign:HintAssist.Hint="Zoomed View" />

                                <Button Grid.Column="1"
            Click="ZoomedViewInfo_Click"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            ToolTip="Zoomed View Information">

                                    <materialDesign:PackIcon Kind="InformationOutline"
                                 Width="18"
                                 Height="18"
                                 Foreground="DodgerBlue"/>
                                </Button>

                            </Grid>


                            <Grid Grid.Row="1"
      Grid.Column="4"
      Margin="0,12,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
              Margin="0,0,5,0"
              materialDesign:HintAssist.Hint="Part Information" />

                                <Button Grid.Column="1"
            Click="PartInformationInfo_Click"
            Background="Transparent"
            BorderThickness="0"
            Padding="0"
            ToolTip="Part Information">

                                    <materialDesign:PackIcon Kind="InformationOutline"
                                 Width="18"
                                 Height="18"
                                 Foreground="DodgerBlue"/>
                                </Button>

                            </Grid>

                        </Grid>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0 5 0 0">

                            <Button Margin="4"
                                    Command="{Binding AddMoreImagesCommand}"
        Style="{StaticResource BlueRaisedButton}">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ImageMultiple"
                                 Width="16"
                                 Height="16"
                                 Margin="0,0,5,0"/>
                                    <TextBlock Text="Add More Images"/>
                                </StackPanel>

                            </Button>

                            <Button Margin="4"
                                    Command="{Binding AddCommand}"
        Style="{StaticResource BlueRaisedButton}">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="PlusCircle"
                                 Width="16"
                                 Height="16"
                                 Margin="0,0,5,0"/>
                                    <TextBlock Text="Add"/>
                                </StackPanel>

                            </Button>

                            <Button Margin="4"
                                    Command="{Binding ClearCommand}"
        Style="{StaticResource BlueRaisedButton}">

                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Broom"
                                 Width="16"
                                 Height="16"
                                 Margin="0,0,5,0"/>
                                    <TextBlock Text="Clear"/>
                                </StackPanel>

                            </Button>

                        </StackPanel>

                    </StackPanel>

                </materialDesign:Card>

                <!-- Data Grid -->
                <materialDesign:Card Margin="0 12 0 0"
                                     BorderThickness="1"
                                     Padding="5">

                    <DataGrid Height="140"
                              AutoGenerateColumns="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DamageText" Binding="{Binding DamageText}"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}"/>
                            <DataGridTextColumn Header="SubType" Binding="{Binding SubType}"/>
                            <DataGridTextColumn Header="Image1" Binding="{Binding Image1}"/>
                            <DataGridTextColumn Header="Image2" Binding="{Binding Image2}"/>
                        </DataGrid.Columns>

                    </DataGrid>

                </materialDesign:Card>

            </StackPanel>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Run"
                    Width="160"
                    Margin="4"
                    Command="{Binding RunCommand}"
                    Style="{StaticResource BlueRaisedButton}"/>

            <Button Content="Close"
                    Width="160"
                    Margin="4"
                    Command="{Binding CloseCommand}"
                    Style="{StaticResource BlueRaisedButton}"/>

        </StackPanel>

    </Grid>

</Window>